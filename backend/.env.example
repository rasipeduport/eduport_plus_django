# Copy to backend/.env and fill in:  cp backend/.env.example backend/.env
# Read by config/settings.py for `manage.py runserver`, and by docker-compose
# via `env_file:` for the container. Docker overrides DB_HOST/DB_PORT.
#
# settings.py FAILS CLOSED: with DEBUG=False it refuses to start on a fallback
# SECRET_KEY or an empty ALLOWED_HOSTS. See docs/production-env.md for the
# production checklist.
#
# DEBUG=False is also fine locally -- the Docker stack runs that way on purpose,
# for parity with production. Over plain HTTP that needs the Secure cookie flags
# turned off; see the cookie section below.

DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required in production: must be 50+ chars and must not start with
# "django-insecure-". The app will not boot otherwise.
SECRET_KEY=change-me

# Required in production: comma-separated hostnames this deployment serves.
# An empty value with DEBUG=False refuses to boot.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

TIME_ZONE=Asia/Kolkata

# Development-only login shortcut: a "mock:<email>:<name>" credential skips
# Google verification entirely and logs in as that email. It is gated on DEBUG
# as well as this flag, so it CANNOT be enabled when DEBUG=False -- setting it
# True in a production environment simply has no effect.
ALLOW_MOCK_AUTH=False

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These target the Dockerised Postgres from your Mac (host port 5433).
# Inside Docker, compose overrides DB_HOST=db and DB_PORT=5432.
DB_NAME=eduplus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# ---------------------------------------------------------------------------
# Cookie-session auth  (required in production)
# ---------------------------------------------------------------------------
# Must match the browser URLs exactly -- scheme + host + port. An empty value
# with DEBUG=False is a deploy-check error: the SPAs call this API
# cross-origin, so an empty allowlist means every browser request fails.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Share cookies across subdomains, e.g. .eduport.co.in. Leave unset locally.
# SESSION_COOKIE_DOMAIN=

# Both default to `not DEBUG`, so a production deployment that omits them gets
# secure cookies automatically. Set them False for a local stack served over
# plain HTTP -- that is a supported, deliberate choice and nothing enforces it.
# CSRF_COOKIE_SECURE falls back to SESSION_COOKIE_SECURE when unset.
SESSION_COOKIE_SECURE=False

HUB_URL=http://localhost:3000
LEARN_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Transport security  (production; all default to OFF)
# ---------------------------------------------------------------------------
# These depend on the TLS topology in front of Django, which this project does
# not assume. Enable them deliberately, in the order documented in
# docs/production-env.md.

# Trust the proxy's "this arrived over HTTPS" header.
# SECURITY WARNING: only enable once the proxy is known to STRIP any
# client-supplied value and set its own. Otherwise a client can send
# `X-Forwarded-Proto: https` and Django will treat plaintext as secure.
# TRUST_PROXY_SSL_HEADER=False
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# Leave False if the proxy already redirects HTTP -> HTTPS (the usual setup).
# Enabling this WITHOUT TRUST_PROXY_SSL_HEADER causes an infinite redirect loop.
# SECURE_SSL_REDIRECT=False
# Path regexes exempt from the redirect, e.g. a health check that can't follow
# a 301:  SECURE_REDIRECT_EXEMPT=^healthz/$
# SECURE_REDIRECT_EXEMPT=

# HSTS is cached by browsers for its full duration and is hard to walk back.
# Ramp it: 3600 -> 86400 -> 31536000, and only then consider the two below.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Everything is written to stdout for the container runtime to collect,
# as plain text with a timestamp, level and logger name.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google. The private key is a server-side secret -- never copy it into a
# frontend .env. Keep the literal \n escapes and wrap it in quotes.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Email. Blank EMAIL_HOST_USER falls back to the console backend (no real
# sends). EMAIL_HOST_PASSWORD is a Gmail app password, not the account password.
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rasip.eduport@gmail.com
