# Copy to backend/.env and fill in:  cp backend/.env.example backend/.env
# Read by config/settings.py for `manage.py runserver`, and by docker-compose
# via `env_file:` for the container. Docker overrides DB_HOST/DB_PORT.

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=Asia/Kolkata

# Enables the "mock:" Google credential shortcut. Never True in production.
ALLOW_MOCK_AUTH=False

# Database. These target the Dockerised Postgres from your Mac (host port 5433).
# Inside Docker, compose overrides DB_HOST=db and DB_PORT=5432.
DB_NAME=eduplus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Cookie-session auth: must match the browser URLs exactly (scheme+host+port).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_COOKIE_SECURE=False
HUB_URL=http://localhost:3000
LEARN_URL=http://localhost:3001

# Google. The private key is a server-side secret -- it must never be copied
# into a frontend .env. Keep the literal \n escapes and wrap it in quotes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Email. Blank EMAIL_HOST_USER falls back to the console backend (no real sends).
# EMAIL_HOST_PASSWORD is a Gmail app password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rasip.eduport@gmail.com
