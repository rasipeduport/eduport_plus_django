# Copy to backend/.env and fill in:  cp backend/.env.example backend/.env
# Read by config/settings.py for `manage.py runserver`, and by docker-compose
# via `env_file:` for the container. Docker overrides DB_HOST/DB_PORT.
#
# settings.py FAILS CLOSED: with DEBUG=False it refuses to start on a fallback
# SECRET_KEY or an empty ALLOWED_HOSTS. See docs/production-env.md for the
# production checklist.
#
# DEBUG=False is also fine locally -- the Docker stack runs that way on purpose,
# for parity with production. Over plain HTTP that needs the Secure cookie flags
# turned off; see the cookie section below.

DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required in production: must be 50+ chars and must not start with
# "django-insecure-". The app will not boot otherwise.
SECRET_KEY=change-me

# Required in production: comma-separated hostnames this deployment serves.
# An empty value with DEBUG=False refuses to boot.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Sign-in, sessions and brute-force protection
# ---------------------------------------------------------------------------
# Staff sign in with username + password (POST /api/auth/login/); Learn's
# students keep Google sign-in until Phase 7. There is no mock login any more.
#
# Sessions have no time limit of their own: they last until logout,
# deactivation or a password change (settings.SESSION_COOKIE_AGE is 400 days,
# the longest the cookie standard lets a browser keep a cookie). There is
# nothing to configure.
#
# Lockout: after LOGIN_MAX_FAILURES consecutive wrong passwords an account is
# locked for LOGIN_LOCKOUT_SECONDS, API and Django admin alike. Counted in the
# database; an administrator unlocks an account in the Django admin.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
#
# Per-address rate limits (DRF rates, "10/min"). Counted in local memory per
# gunicorn worker, so approximate; no Redis is involved in signing in.
# LOGIN_THROTTLE_IP_RATE=10/min
# PASSWORD_CHANGE_THROTTLE_RATE=10/hour
#
# Client address for the per-address limit and the audit log. Number of
# reverse proxies in front of Django that APPEND to X-Forwarded-For; only
# their entries are trusted. 0 = ignore the header (nothing proxies the API,
# as in the local stack). Behind one TLS proxy: NUM_PROXIES=1.
# NUM_PROXIES=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These target the Dockerised Postgres from your Mac (host port 5433).
# Inside Docker, compose overrides DB_HOST=db and DB_PORT=5432.
DB_NAME=eduplus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# ---------------------------------------------------------------------------
# Cookie-session auth  (required in production)
# ---------------------------------------------------------------------------
# Must match the browser URLs exactly -- scheme + host + port. An empty value
# with DEBUG=False is a deploy-check error: the SPAs call this API
# cross-origin, so an empty allowlist means every browser request fails.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Share cookies across subdomains, e.g. .eduport.co.in. Leave unset locally.
# SESSION_COOKIE_DOMAIN=

# Both default to `not DEBUG`, so a production deployment that omits them gets
# secure cookies automatically. CSRF_COOKIE_SECURE falls back to
# SESSION_COOKIE_SECURE when unset.
#
# A local stack served over plain http:// cannot use Secure cookies. Because
# the login cookies are the whole login, settings.py REFUSES TO BOOT with
# DEBUG=False and insecure cookies unless ALLOW_INSECURE_COOKIES=True is set
# explicitly -- and even then only while every CORS/CSRF origin above is
# http://localhost or a loopback address. Local development only.
SESSION_COOKIE_SECURE=False
ALLOW_INSECURE_COOKIES=True

HUB_URL=http://localhost:3000
LEARN_URL=http://localhost:3001
# The public booking site a BDE's Demo/Diagnostic links point at
# (<url>/demo?ref=..., <url>/exam?ref=...). Defaults to the live site.
# MARKETING_SITE_URL=https://plus.eduport.app

# ---------------------------------------------------------------------------
# Transport security  (production; all default to OFF)
# ---------------------------------------------------------------------------
# These depend on the TLS topology in front of Django, which this project does
# not assume. Enable them deliberately, in the order documented in
# docs/production-env.md.

# Trust the proxy's "this arrived over HTTPS" header.
# SECURITY WARNING: only enable once the proxy is known to STRIP any
# client-supplied value and set its own. Otherwise a client can send
# `X-Forwarded-Proto: https` and Django will treat plaintext as secure.
# TRUST_PROXY_SSL_HEADER=False
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# Leave False if the proxy already redirects HTTP -> HTTPS (the usual setup).
# Enabling this WITHOUT TRUST_PROXY_SSL_HEADER causes an infinite redirect loop.
# SECURE_SSL_REDIRECT=False
# Path regexes exempt from the redirect, e.g. a health check that can't follow
# a 301:  SECURE_REDIRECT_EXEMPT=^healthz/$
# SECURE_REDIRECT_EXEMPT=

# HSTS is cached by browsers for its full duration and is hard to walk back.
# Ramp it: 3600 -> 86400 -> 31536000, and only then consider the two below.
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Everything is written to stdout for the container runtime to collect,
# as plain text with a timestamp, level and logger name.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google. The private key is a server-side secret -- never copy it into a
# frontend .env. Keep the literal \n escapes and wrap it in quotes.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Celery / Redis. One scheduled job: the enrolment-sheet class-quota sync
# (students.tasks.sync_student_quotas -> Student.total_class_quota). It also
# needs the GOOGLE_* values above, and DB_* to write what it reads.
#
# Three processes read this file: Django, `celery worker` and `celery beat`.
# Which of them needs what:
#
#   CELERY_BROKER_URL           worker, beat   (Django too, so all three agree)
#   QUOTA_SYNC_CRON_MINUTE      beat only
#   QUOTA_SYNC_CRON_HOUR        beat only
#   CELERY_TASK_*_TIME_LIMIT    worker only
#   CELERY_TASK_ALWAYS_EAGER    Django only (tests; and local runs without Redis)
#
# Every one has a working default in config/settings.py, so a deployment that
# sets none still boots -- it just talks to a Redis on localhost.
#
# BROKER URL, per environment:
#   native (this file)  redis://localhost:6380/0   <- the compose Redis, published
#                                                     on the host loopback
#   docker compose      redis://redis:6379/0       <- set in docker-compose.yml
#                                                     on backend, worker AND beat;
#                                                     never `localhost` from a
#                                                     container
#   production          supply your own, WITH credentials, through the
#                       platform's secret store (see below). Do NOT write a
#                       credentialed URL into this file or any tracked file.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6380/0
# Crontab fields for the sync. Default: every hour at :20.
QUOTA_SYNC_CRON_MINUTE=20
QUOTA_SYNC_CRON_HOUR=*
# Seconds before a stuck Sheets call is killed. The sync aborts without
# writing, so being killed mid-fetch changes no quota.
# CELERY_TASK_SOFT_TIME_LIMIT=300
# CELERY_TASK_TIME_LIMIT=360
# Runs tasks inline with no broker at all -- tests set this; handy locally too.
# CELERY_TASK_ALWAYS_EAGER=False

# ---------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT NOTE
# ---------------------------------------------------------------------------
# This project has no secrets mechanism of its own: there is no CI, no Helm
# chart and no deploy script -- only docker-compose.yml and the Dockerfiles.
# So a real deployment must inject these through whatever its platform uses
# (ECS task definition, Kubernetes Secret, Render/Railway/Fly env group,
# systemd EnvironmentFile outside the repo, ...).
#
# Sign-in (Phase 2) needs, in production:
#
#   SESSION_COOKIE_SECURE=True (CSRF_COOKIE_SECURE follows it), and NO
#                       ALLOW_INSECURE_COOKIES. HTTPS origins only.
#   NUM_PROXIES        The number of proxies that append X-Forwarded-For
#                       (usually 1). Wrong values make the per-address limit
#                       spoofable (too high) or shared by everyone (too low).
#   SESSION_COOKIE_DOMAIN  Only needed for Hub and Learn to share one login;
#                       the CSRF token travels in response bodies, not via
#                       document.cookie, so cross-host APIs work without it.
#
# Beyond the existing variables, the quota sync adds exactly ONE required new
# one, plus two optional:
#
#   CELERY_BROKER_URL   REQUIRED. rediss://:<password>@<host>:<port>/<db>
#                       Use rediss:// (TLS) and a password: unlike the compose
#                       Redis, a managed broker is reachable off-host. SECRET.
#   QUOTA_SYNC_CRON_MINUTE / QUOTA_SYNC_CRON_HOUR
#                       Optional. Not secret. Defaults to hourly at :20.
#
# And it needs two processes running alongside gunicorn, both from the SAME
# image and the SAME environment as the web service:
#
#   celery -A config worker --loglevel=info --concurrency=2
#   celery -A config beat   --loglevel=info --schedule /tmp/celerybeat-schedule
#
# Run exactly ONE beat. Two would double every sync -- harmless here (the sync
# is idempotent) but it would double the Google API calls.
#
# The worker needs GOOGLE_* and DB_* (it reads the sheet and writes students).
# Beat needs neither -- it only enqueues -- but gets them harmlessly by
# sharing the environment.
#
# Run `python manage.py sync_student_quotas --dry-run` once after deploying to
# confirm the sheet is reachable and see what the first real sync would change.

# ---------------------------------------------------------------------------
# Email. Blank EMAIL_HOST_USER falls back to the console backend (no real
# sends). EMAIL_HOST_PASSWORD is a Gmail app password, not the account password.
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rasip.eduport@gmail.com

# ---------------------------------------------------------------------------
# Uploaded session content (notes / recording / homework files). Optional.
# ---------------------------------------------------------------------------
# Where the bytes live; served only via the authenticated API, never as static.
# Docker mounts the `media` volume here (docker-compose.yml).
# MEDIA_ROOT=/app/media
# Size ceilings per kind, in MB (defaults: 50 / 50 / 500).
# SESSION_CONTENT_MAX_MB_DOCUMENT=50
# SESSION_CONTENT_MAX_MB_IMAGE=50
# SESSION_CONTENT_MAX_MB_VIDEO=500
