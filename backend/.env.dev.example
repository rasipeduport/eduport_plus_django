# DEV environment reference for docker-compose.dev.yml (Dokploy).
#
# Documentation only -- nothing reads this file. Paste the values into
# Dokploy -> <DEV compose service> -> Environment. Never put real secrets
# here, and never reuse a production value in DEV (or the reverse).
#
# Dokploy service: Compose, branch `dev`, Compose Path ./docker-compose.dev.yml.
#   Domains   -> service `backend`, port 8000, HTTPS on (Let's Encrypt).
#                DEV needs its own HTTPS domains: Django refuses to start
#                without Secure cookies.
#   Advanced  -> Isolated Deployments on; Randomize off.
#   Stripe    -> test-mode webhook endpoint https://<api host>/api/sales/webhooks/stripe/
#
# backend/.env.example is the LOCAL developer file; its DB_HOST and broker URL
# point at localhost and are unreachable from inside the Dokploy stack.
#
# Variables with no value below are REQUIRED: docker-compose.dev.yml declares
# them as ${VAR:?message}, so a missing one aborts the deploy. Everything else
# reaches Django through `env_file: .env` and keeps its config/settings.py
# default when left out. Leave an optional variable OUT rather than blank: a
# blank number (e.g. PAYMENT_PROOF_MAX_MB=) stops Django at startup.
#
# Fixed by docker-compose.dev.yml and not settable here:
#   DEBUG=False, DB_HOST=eduplus-dev-db, DB_PORT=5432, DB_NAME=eduplus_dev,
#   DB_USER=eduplus_dev, MEDIA_ROOT=/app/media, CELERY_BROKER_URL (built from
#   REDIS_PASSWORD), SESSION_COOKIE_SECURE=True, CSRF_COOKIE_SECURE=True,
#   TRUST_PROXY_SSL_HEADER=True, SECURE_HSTS_SECONDS=0, STRIPE_LIVE_MODE=False,
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PUBLISHABLE_KEY (taken
#   from the STRIPE_TEST_* names below), EMAIL_HOST_USER and EMAIL_HOST_PASSWORD
#   blank (emails are logged, never sent), COMMUNICATIONS_SENDING_ENABLED=False,
#   COMMUNICATIONS_ALLOW_ALL_RECIPIENTS=False.

# --- Django -------------------------------------------------------------------
# 50+ chars, must not start with "django-insecure-", must NOT be the
# production key.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated, no scheme. `localhost` is required: the backend healthcheck
# curls localhost:8000, and a rejected Host would leave worker and beat waiting
# forever for a healthy backend.
ALLOWED_HOSTS=api-dev.example.com,localhost

# Scheme + host exactly as the browser sees the DEV SPAs. CORS runs with
# credentials, so a mismatch fails every browser request.
CORS_ALLOWED_ORIGINS=https://hub-dev.example.com,https://learn-dev.example.com
CSRF_TRUSTED_ORIGINS=https://hub-dev.example.com,https://learn-dev.example.com

# Embedded in invitation links.
HUB_URL=https://hub-dev.example.com
LEARN_URL=https://learn-dev.example.com

# Where BDE booking links point. Must NOT be the production marketing site:
# a tester's booking there becomes a real lead.
MARKETING_SITE_URL=

# Learn initial credentials. A DEV-only key, never the production one.
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LEARN_INVITATION_KEYS=

# --- Postgres and Redis (this stack's own containers) ---------------------------
DB_PASSWORD=
# Goes inside the broker URL, so keep it URL-safe:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- Stripe (test mode only) ----------------------------------------------------
# sk_test_ / whsec_ / pk_test_. A live key leaves payments "not configured".
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PUBLISHABLE_KEY=
# Approved public terms, https only.
AUTOPAY_TERMS_URL=

# --- Optional -------------------------------------------------------------------
# Defaulted in docker-compose.dev.yml:
#   NUM_PROXIES=1            Traefik only; 2 if a CDN proxy also sits in front
#   GUNICORN_WORKERS=2
#   CELERY_CONCURRENCY=2
#   QUOTA_SYNC_CRON_HOUR=3   daily at 03:20; "*" for production's hourly sync
#
# Enrolment-sheet quota sync. Use a COPY of the enrolment sheet -- the
# production sheet would pull real student data into DEV. Leave all three out
# to deploy without the sync wired up. Keep the literal \n escapes in the
# private key and quote the value.
#   GOOGLE_SHEET_ID=
#   GOOGLE_SERVICE_ACCOUNT_EMAIL=
#   GOOGLE_PRIVATE_KEY=
#
# SESSION_COOKIE_DOMAIN: leave it out. A parent domain shared with production
# would make the two environments' session cookies collide.
#
# Everything else -- SALES_*, limits and throttle rates -- is optional and
# documented in backend/.env.example.
