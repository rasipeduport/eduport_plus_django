# DEV environment reference for docker-compose.dev.yml (Dokploy).
#
# Documentation only -- nothing reads this file. Paste the values into
# Dokploy -> <DEV application> -> Environment. Never put real secrets here.
#
# backend/.env.example is the LOCAL developer file; its DB_HOST and broker URL
# point at localhost and are unreachable from inside the Dokploy stack.
#
# Variables with no value below are REQUIRED: docker-compose.dev.yml declares
# them as ${VAR:?message}, so a missing one aborts the deploy.

# Public hostname Traefik routes to the backend. Not passed to Django.
API_DOMAIN=api-dev.example.com

# 50+ chars, must not start with "django-insecure-", must NOT be the production
# key.  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated, no scheme. `localhost` is required: the backend healthcheck
# curls localhost:8000, and a rejected Host would leave worker and beat waiting
# forever for a healthy backend.
ALLOWED_HOSTS=api-dev.example.com,localhost

# DB_HOST and DB_PORT are pinned to db:5432 in the compose file and cannot be
# set here -- entrypoint.sh migrates on every boot, so this stack must not be
# able to reach the production database.
DB_NAME=eduplus_dev
DB_USER=eduplus
DB_PASSWORD=

# Scheme + host exactly as the browser sees the DEV SPAs. CORS runs with
# credentials, so a mismatch fails every browser request.
CORS_ALLOWED_ORIGINS=https://hub-dev.example.com,https://learn-dev.example.com
CSRF_TRUSTED_ORIGINS=https://hub-dev.example.com,https://learn-dev.example.com

# Embedded in invitation links.
HUB_URL=https://hub-dev.example.com
LEARN_URL=https://learn-dev.example.com

# Register a separate DEV OAuth client; do not add DEV origins to the
# production one. Nobody can log in without this.
GOOGLE_OAUTH_CLIENT_ID=

# Quota sync (students.tasks.sync_student_quotas). Use a COPY of the enrolment
# sheet -- the production sheet would pull real student data into DEV. Leave
# all three blank to deploy without the sync wired up.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the literal \n escapes and quote the value.
GOOGLE_PRIVATE_KEY=

# Sync schedule. Daily at 03:20; set HOUR=* for production parity.
QUOTA_SYNC_CRON_MINUTE=20
QUOTA_SYNC_CRON_HOUR=3

# Leave blank so DEV logs invitation emails instead of sending them.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional overrides, defaulted in docker-compose.dev.yml:
#   LOG_LEVEL, GUNICORN_WORKERS, CELERY_CONCURRENCY
#
# Fixed by docker-compose.dev.yml and not settable here:
#   DEBUG=False, DB_HOST=db, DB_PORT=5432, MEDIA_ROOT=/app/media,
#   CELERY_BROKER_URL=redis://redis:6379/0, SESSION_COOKIE_SECURE=True,
#   CSRF_COOKIE_SECURE=True, TRUST_PROXY_SSL_HEADER=True,
#   SECURE_SSL_REDIRECT=False, SECURE_HSTS_SECONDS=0
#
# SESSION_COOKIE_DOMAIN is intentionally not wired up: a parent domain shared
# with production would make the two environments' session cookies collide.
#
# Everything else (TIME_ZONE, EMAIL_HOST/PORT/USE_TLS, DEFAULT_FROM_EMAIL,
# upload size limits) keeps its config/settings.py default.
