# PRODUCTION environment reference for docker-compose.prod.yml (Dokploy).
#
# Documentation only -- nothing reads this file. Paste the values into
# Dokploy -> <production compose service> -> Environment. Never put real
# secrets here, and never reuse a production value in DEV (or the reverse).
#
# Dokploy service: Compose, branch `main`, Compose Path ./docker-compose.prod.yml.
#   Domains   -> service `backend`, port 8000, HTTPS on (Let's Encrypt).
#   Advanced  -> Isolated Deployments on; Randomize off.
#   Stripe    -> live-mode webhook endpoint https://<api host>/api/sales/webhooks/stripe/
#
# Variables with no value below are REQUIRED: docker-compose.prod.yml declares
# them as ${VAR:?message}, so a missing one aborts the deploy. Everything else
# reaches Django through `env_file: .env` and keeps its config/settings.py
# default when left out. Leave an optional variable OUT rather than blank: a
# blank number (e.g. PAYMENT_PROOF_MAX_MB=) stops Django at startup.
#
# Fixed by docker-compose.prod.yml and not settable here:
#   DEBUG=False, DB_HOST=eduplus-prod-db, DB_PORT=5432, MEDIA_ROOT=/app/media,
#   CELERY_BROKER_URL (built from REDIS_PASSWORD), SESSION_COOKIE_SECURE=True,
#   CSRF_COOKIE_SECURE=True, TRUST_PROXY_SSL_HEADER=True, STRIPE_LIVE_MODE=True,
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PUBLISHABLE_KEY (taken
#   from the STRIPE_LIVE_* names below).

# --- Django -------------------------------------------------------------------
# 50+ chars, must not start with "django-insecure-".
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated, no scheme. `localhost` is required: the backend healthcheck
# curls localhost:8000, and a rejected Host would leave worker and beat waiting
# forever for a healthy backend.
ALLOWED_HOSTS=api.example.com,localhost

# Scheme + host exactly as the browser sees the production SPAs. CORS runs
# with credentials, so a mismatch fails every browser request.
CORS_ALLOWED_ORIGINS=https://hub.example.com,https://learn.example.com
CSRF_TRUSTED_ORIGINS=https://hub.example.com,https://learn.example.com

# Embedded in invitation links.
HUB_URL=https://hub.example.com
LEARN_URL=https://learn.example.com

# Learn initial credentials: comma-separated Fernet keys, newest first. Keep
# older keys until pending invitations are rotated or activated.
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
LEARN_INVITATION_KEYS=

# --- Postgres and Redis (this stack's own containers) ---------------------------
# Name and user are only applied when the database volume is first created.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Goes inside the broker URL, so keep it URL-safe:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- Stripe (live mode only) ----------------------------------------------------
# sk_live_ / whsec_ / pk_live_. A test key leaves payments "not configured".
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PUBLISHABLE_KEY=
# Approved public terms, https only; also set in the Stripe Dashboard.
AUTOPAY_TERMS_URL=

# --- Optional -------------------------------------------------------------------
# Defaulted in docker-compose.prod.yml:
#   NUM_PROXIES=1            Traefik only; 2 if a CDN proxy also sits in front
#   GUNICORN_WORKERS=3
#   CELERY_CONCURRENCY=2
#
# HSTS is hard to walk back. Ramp it only once HTTPS is confirmed end to end:
#   SECURE_HSTS_SECONDS=3600 -> 86400 -> 31536000
#
# Keys the marketing site's server presents to /api/public/ (comma-separated).
#   BOOKING_SERVICE_API_KEYS=
#
# Enrolment-sheet quota sync (students.tasks.sync_student_quotas). Keep the
# literal \n escapes in the private key and quote the value.
#   GOOGLE_SHEET_ID=
#   GOOGLE_SERVICE_ACCOUNT_EMAIL=
#   GOOGLE_PRIVATE_KEY=
#
# Everything else -- EMAIL_*, COMMUNICATIONS_*, MARKETING_SITE_URL,
# SESSION_COOKIE_DOMAIN, SALES_*, limits and throttle rates -- is optional and
# documented in backend/.env.example.
