# Copy to .env and fill in.  Docker Compose reads this file automatically.
#   cp .env.example .env

# ---- Django ----------------------------------------------------------
# Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=Asia/Kolkata

# Enables the "mock:" Google credential shortcut. Never True in production.
ALLOW_MOCK_AUTH=False

# ---- Database --------------------------------------------------------
DB_NAME=eduplus
DB_USER=postgres
DB_PASSWORD=postgres
# Host port for reaching Postgres from your Mac (container port stays 5432).
# Defaults to 5433 so it won't collide with a Postgres you already run locally.
DB_PORT_HOST=5433

# ---- Ports on your machine -------------------------------------------
BACKEND_PORT=8000
HUB_PORT=3000
LEARN_PORT=3001

# ---- Cross-origin (cookie session auth -- these must match exactly) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
SESSION_COOKIE_SECURE=False
HUB_URL=http://localhost:3000
LEARN_URL=http://localhost:3001

# Baked into the frontend bundles at build time.
VITE_API_URL=http://localhost:8000

# ---- Google ----------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the literal \n escapes and wrap the whole value in double quotes.
GOOGLE_PRIVATE_KEY=

# ---- Email (blank EMAIL_HOST_USER => console backend, no real sends) --
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=rasip.eduport@gmail.com
