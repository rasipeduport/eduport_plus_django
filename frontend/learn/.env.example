# Copy to frontend/learn/.env:  cp frontend/learn/.env.example frontend/learn/.env
# Auto-loaded by `npm run dev` (port 3001) AND by `npm run build` inside Docker.
#
# WARNING: every VITE_* value is compiled into the browser bundle and is
# therefore PUBLIC. The OAuth *client id* is fine here. Never put the Google
# private key, the Gmail app password, or SECRET_KEY in this file --
# those belong in backend/.env.

VITE_API_URL=http://localhost:8000
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_HUB_URL=http://localhost:3000
VITE_LEARN_URL=http://localhost:3001
