# Copy to frontend/hub/.env:  cp frontend/hub/.env.example frontend/hub/.env
# Auto-loaded by `npm run dev` (port 3000) AND by `npm run build` inside Docker.
#
# WARNING: every VITE_* value is compiled into the browser bundle and is
# therefore PUBLIC. Never put the Google private key, the Gmail app password,
# or SECRET_KEY in this file -- those belong in backend/.env. The Hub has no
# Google sign-in (staff use a username and password), so it needs no OAuth
# client id; Learn's .env keeps one for students.

VITE_API_URL=http://localhost:8000
VITE_HUB_URL=http://localhost:3000
VITE_LEARN_URL=http://localhost:3001
